-- Right Panel
local rightPanel = Instance.new("Frame")
rightPanel.Size = UDim2.new(0.75, 0, 1, -80)
rightPanel.Position = UDim2.new(0.25, 0, 0, 80)
rightPanel.BackgroundColor3 = C_BG
rightPanel.Parent = mainFrame

local codeBox = Instance.new("TextBox")
codeBox.Size = UDim2.new(1, -20, 1, -20)
codeBox.Position = UDim2.new(0, 10, 0, 10)
codeBox.BackgroundColor3 = C_BG
codeBox.TextColor3 = C_TEXT
codeBox.Font = Enum.Font.Code
codeBox.TextSize = 14
codeBox.TextXAlignment = Enum.TextXAlignment.Left
codeBox.TextYAlignment = Enum.TextYAlignment.Top
codeBox.MultiLine = true
codeBox.ClearTextOnFocus = false
codeBox.Text = ""
codeBox.Parent = rightPanel

-- ==========================================
-- LOGIC
-- ==========================================
local activeScript = nil
local currentFilteredScripts = {}

local function sendLog(msg)
	task.spawn(function()
		pcall(function()
			local payload = HttpService:JSONEncode({message = msg})
			HttpService:PostAsync("http://127.0.0.1:17614/api2/studio/log", payload, Enum.HttpContentType.ApplicationJson)
		end)
	end)
end

local function apiPost(endpoint, body)
	local payload = HttpService:JSONEncode(body)
	local success, response = pcall(function()
		return HttpService:PostAsync("http://127.0.0.1:17614" .. endpoint, payload, Enum.HttpContentType.ApplicationJson)
	end)
	if success then
		return HttpService:JSONDecode(response)
	else
		return { ok = false, error = tostring(response) }
	end
end

local function openScript(scriptObj)
	activeScript = scriptObj
	codeBox.Text = scriptObj.Source
	sendLog("Selected script: " .. scriptObj.Name)
end

local function refreshExplorer(filterText)
	scriptList:ClearAllChildren()
	local layout = Instance.new("UIListLayout", scriptList)
	layout.Padding = UDim.new(0, 2)
	layout.SortOrder = Enum.SortOrder.Name

	filterText = filterText:lower()
	currentFilteredScripts = {}

	for _, obj in ipairs(game:GetDescendants()) do
		if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
			if filterText == "" or obj.Name:lower():find(filterText) then
				table.insert(currentFilteredScripts, obj)
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, -6, 0, 24)
				btn.BackgroundColor3 = C_PANEL
				btn.Text = "  📄 " .. obj.Name
				btn.TextColor3 = C_TEXT
				btn.Font = Enum.Font.Code
				btn.TextSize = 12
				btn.TextXAlignment = Enum.TextXAlignment.Left
				btn.Parent = scriptList
				btn.MouseButton1Click:Connect(function() openScript(obj) end)
			end
		end
	end
end

task.spawn(function()
	while true do
		task.wait(5)
		local res = apiPost("/api2/studio/format", { code = "ping" })
		if res and res.ok then
			consoleLog.Text = "[Connected] Bridge is Online.\n"
			consoleLog.TextColor3 = C_OK
		else
			consoleLog.Text = "[Offline] Bridge not found.\nMake sure app2.py is running."
			consoleLog.TextColor3 = C_ERR
		end
	end
end)

-- ==========================================
-- BUTTON ACTIONS
-- ==========================================
btnConnect.MouseButton1Click:Connect(function()
	consoleLog.Text = "Pinging Python backend..."
	sendLog("Clicked: Connect Tool")
	local res = apiPost("/api2/studio/format", { code = "ping" })
	if res and res.ok then
		consoleLog.Text = "✅ Connected! Backend is running."
		consoleLog.TextColor3 = C_OK
		sendLog("Result: Connected successfully.")
	else
		consoleLog.Text = "❌ Offline! Check app2.py terminal."
		consoleLog.TextColor3 = C_ERR
		sendLog("Result: Connection failed.")
	end
end)

btnTrash.MouseButton1Click:Connect(function()
	sendLog("Clicked: Move All to Trash")
	local trash = game:GetService("ServerStorage"):FindFirstChild("ZeroScript_Trash")
	if not trash then
		trash = Instance.new("Folder")
		trash.Name = "ZeroScript_Trash"
		trash.Parent = game:GetService("ServerStorage")
	end

	local count = 0
	for _, obj in ipairs(game:GetDescendants()) do
		if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
			if not obj:IsDescendantOf(trash) then
				obj.Parent = trash
				count = count + 1
			end
		end
	end
	refreshExplorer("")
	consoleLog.Text = "⚠️ Moved " .. count .. " scripts to Trash folder!"
	consoleLog.TextColor3 = C_ERR
	sendLog("Moved " .. count .. " scripts to ServerStorage.ZeroScript_Trash")
end)

btnFormat.MouseButton1Click:Connect(function()
	if not activeScript then return end
	sendLog("Clicked: Format Code on " .. activeScript.Name)
	consoleLog.Text = "Formatting code..."
	local res = apiPost("/api2/studio/format", { code = codeBox.Text })
	if res.ok then
		codeBox.Text = res.result.code
		activeScript.Source = codeBox.Text
		consoleLog.Text = "✅ Formatted successfully."
		consoleLog.TextColor3 = C_OK
		sendLog("Formatted successfully.")
	else
		consoleLog.Text = "❌ Format failed."
		sendLog("Format failed.")
	end
end)

btnFix.MouseButton1Click:Connect(function()
	if not activeScript then return end
	sendLog("Clicked: AI Fix on " .. activeScript.Name)
	consoleLog.Text = "AI fixing code..."
	local res = apiPost("/api2/studio/ai_fix", { code = codeBox.Text })
	if res.ok then
		codeBox.Text = res.result.code
		activeScript.Source = codeBox.Text
		consoleLog.Text = "✅ Fixed by AI."
		consoleLog.TextColor3 = C_OK
		sendLog("AI Fix applied successfully.")
	else
		consoleLog.Text = "❌ AI Fix failed."
		sendLog("AI Fix failed.")
	end
end)

btnReplaceAll.MouseButton1Click:Connect(function()
	local find = findBox.Text
	local replace = replaceBox.Text
	if find == "" then return end

	sendLog("Clicked: Replace All ("..find.." -> "..replace..")")
	local count = 0
	for _, scriptObj in ipairs(currentFilteredScripts) do
		local newSource, hits = scriptObj.Source:gsub(find, replace)
		if hits > 0 then
			scriptObj.Source = newSource
			count = count + 1
		end
	end
	consoleLog.Text = "✅ Replaced in "..count.." scripts."
	sendLog("Replaced in "..count.." scripts.")
end)

btnOpenNative.MouseButton1Click:Connect(function()
	if activeScript then
		plugin:OpenScript(activeScript)
		sendLog("Opened " .. activeScript.Name .. " in Studio Editor")
	end
end)

btnRun.MouseButton1Click:Connect(function()
	if not activeScript then return end
	sendLog("Clicked: Run Code for " .. activeScript.Name)
	activeScript.Source = codeBox.Text
	local success, err = pcall(function()
		local fn = loadstring(codeBox.Text)
		if fn then fn() end
	end)
	if not success then 
		warn("Run Error: " .. tostring(err)) 
		sendLog("Run Error: " .. tostring(err))
	else
		sendLog("Code executed successfully.")
	end
end)

btnSync.MouseButton1Click:Connect(function()
	if not activeScript then return end
	sendLog("Clicked: Sync Web for " .. activeScript.Name)
	activeScript.Source = codeBox.Text
	local res = apiPost("/api2/studio/run", { code = codeBox.Text })
	if res.ok then
		consoleLog.Text = "✅ Synced to Web Dashboard."
		sendLog("Synced to Web.")
	else
		consoleLog.Text = "❌ Sync failed."
		sendLog("Sync to Web failed.")
	end
end)

searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	refreshExplorer(searchBox.Text)
end)

toggleBtn.Click:Connect(function()
	widget.Enabled = not widget.Enabled
	if widget.Enabled then refreshExplorer("") end
end)

refreshExplorer("")]]></ProtectedString>
